{
  "manifest_version": 3,
  "name": "Session Bridge",
  "version": "0.1.0",
  "description": "在隔离的无痕窗口中打开本人或已获授权的 ChatGPT 会话。",
  "incognito": "spanning",
  "permissions": [
    "cookies",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Session Bridge",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
